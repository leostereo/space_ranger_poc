+// src/poc3-jetpack_character_fsm/character-fsm/character.state.jetpack.ts
+import type { ICharacterMainState } from "./character.state";
+import { JetpackFsm } from "./character.fsm.jetpack";
+
+export class JetpackState implements ICharacterMainState {
+  private subFsm: JetpackFsm;
+  private hasFuelFn: () => boolean = () => true;
+
+  constructor() {
+    this.subFsm = new JetpackFsm();
+  }
+
+  // Este método recibirá la función de combustible de la estrategia
+  public setPhysicsDeps(deps: { hasFuel: () => boolean }): void {
+    this.hasFuelFn = deps.hasFuel;
+  }
+
+  // Exponemos el chequeo para que la FSM raíz pueda leerlo en su tabla de transiciones
+  public checkFuel(): boolean {
+    return this.hasFuelFn();
+  }
+
+  enter(): void {}
+  tick(): void { this.subFsm.tick(); }
+  exit(): void {}
+  getHUDLabel(): string { return this.subFsm.getState(); }
+  dispose(): void { this.subFsm.dispose(); }
+}
