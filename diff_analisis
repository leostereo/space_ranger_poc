+// src/poc3-jetpack_character_fsm/character-fsm/character.state.standalone.ts
+import type { ICharacterMainState } from "./character.state";
+import { StandAloneFsm } from "./character.fsm.stand-alone";
+
+export class StandAloneState implements ICharacterMainState {
+  private subFsm: StandAloneFsm | null = null;
+  private onEnterStandAlone: () => void;
+
+  constructor(deps: { onEnterStandAlone: () => void }) {
+    this.onEnterStandAlone = deps.onEnterStandAlone;
+  }
+
+  // Este método recibirá la física fresca de la estrategia
+  public setPhysicsDeps(deps: { isGroundDetected: () => boolean; onEnterOnAir: () => void }): void {
+    // Si ya existía una sub-fsm, la limpiamos primero para evitar fugas de memoria
+    if (this.subFsm) this.subFsm.dispose(); 
+    
+    this.subFsm = new StandAloneFsm({
+      isGroundDetected: deps.isGroundDetected,
+      onEnterOnAir: deps.onEnterOnAir,
+    });
+  }
+
+  enter(): void { this.onEnterStandAlone(); }
+  tick(): void { this.subFsm?.tick(); }
+  exit(): void {}
+  getHUDLabel(): string { return this.subFsm?.getState() ?? "OnGround"; }
+  dispose(): void { this.subFsm?.dispose(); }
+
+  // Reenvía el frame de animación a su sub-fsm interna
+  notifyJumpImpulseFrame(): void {
+    this.subFsm?.notifyJumpImpulseFrame();
+  }
+}
