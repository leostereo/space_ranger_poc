const sentinel = (position: Vector3, volume: PatrolVolume, fireDelaySeconds: number): EnemySpawn => ({
  position,
  forward: new Vector3(0, 0, -1),
  fireDelaySeconds,
  patrol: { volume, plane: FLIGHT_PLANE },
});

