hash_of() {
  if command -v sha256sum > /dev/null 2>&1; then
    tr -d '\r' < "$1" | sha256sum | cut -d' ' -f1
  else
    tr -d '\r' < "$1" | shasum -a 256 | cut -d' ' -f1
  fi
}

# Borra $1 solo si es idéntico a la versión que entregó 001 ($2 = sha256).
remove_if_ours() {
